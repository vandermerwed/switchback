---
import "../styles/global.css";
import AgentReply from "../components/AgentReply.astro";
import MarkedPage from "../components/MarkedPage.astro";
import SiteNav from "../components/SiteNav.astro";
import workbooks from "../generated/showcase.json";

const COUNT_WORDS = ["No", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten"];
const count = COUNT_WORDS[workbooks.length] ?? String(workbooks.length);
// Every example says what it is: its style, and the shelf its pages come from. A proof prints
// your own document, so it comes from no shelf.
const sourceOf = (workbook) => (workbook.collection ? workbook.collectionName : "your own document");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Showcase — Switchback</title>
    <meta name="description" content={`${count} real Switchback workbooks, each labelled with its style and the collection its pages come from, with every page and a PDF.`} />
  </head>
  <body>
    <SiteNav />
    <main class="gallery">
      <header class="gallery-intro">
        <h1>Pages to work on.</h1>
        <p>{count} examples printed by the current Switchback renderer. Each one names its style, the shape of the session, and the collection its pages come from. Each page below is the renderer's own output, shown at A4 proportions. Open a page at full size to inspect the print.</p>
      </header>
      <div class="gallery-grid">
        <nav class="gallery-index" aria-label="Showcase examples">
          {workbooks.map((workbook) => <a href={`#${workbook.id}`}><span>{workbook.title}</span><small>{workbook.styleLabel} · {sourceOf(workbook)}</small></a>)}
        </nav>
        <div class="gallery-examples">
          {workbooks.map((workbook) => {
            const feature = workbook.pagePreviews[Math.min(1, workbook.pagePreviews.length - 1)];
            return <section class="workbook" id={workbook.id} aria-labelledby={`${workbook.id}-title`}>
              <div class="workbook-heading"><h2 id={`${workbook.id}-title`}>{workbook.title}</h2><p>{workbook.pageCount} {workbook.pageCount === 1 ? "page" : "pages"} · {workbook.timebox}</p></div>
              <p class="workbook-tags"><a href="/docs/styles/">{workbook.styleLabel}</a> · {workbook.collection ? <a href={`/docs/collections/${workbook.collection}/`}>{workbook.collectionName} collection</a> : "your own document"}</p>
              <p class="request-label">Request</p>
              <blockquote>“{workbook.request}”</blockquote>
              <p class="style-reason"><strong>Why {workbook.styleLabel}</strong> {workbook.why}</p>
              <div class="page-strip" aria-label={`All ${workbook.pageCount} pages of ${workbook.title}`}>
                {workbook.pagePreviews.map((page, index) => <a class="page-thumb" href={page.html} aria-label={`Open page ${index + 1} of ${workbook.title} at full size`}>
                  <span class:list={["thumb-paper", { "is-landscape": page.orientation === "landscape" }]}><iframe src={page.html} title={`${workbook.title}, ${page.id}, thumbnail`} loading="lazy" tabindex="-1"></iframe></span>
                  <span>{page.id}</span>
                </a>)}
              </div>
              <div class="feature-layout">
                <div class:list={["feature-paper", { "is-landscape": feature.orientation === "landscape" }]}><iframe src={feature.html} title={`${workbook.title}, ${feature.id}, printed page`} loading="lazy"></iframe></div>
                <div class="feature-caption"><p>One page from this example, shown as printed.</p><a href={feature.html}>Open this page full size</a><a href={workbook.pdf} download>Download the PDF</a></div>
              </div>
            </section>;
          })}
        </div>
      </div>
      <section class="returned" aria-labelledby="returned-title">
        <div class="marked-intro"><h2 id="returned-title">When the page returns.</h2><p>One matched, illustrative example: the page is renderer output, and the handwriting and the reply were written for it. <a href="/#how-it-works">See the whole round trip</a></p></div>
        <div class="returned-pair">
          <figure class="returned-page"><MarkedPage /><figcaption>Illustrative example: page 2 of a sitting to plan a talk, with sample handwriting.</figcaption></figure>
          <AgentReply />
        </div>
      </section>
    </main>
    <footer class="site-footer"><span>Switchback · paper back to the agent</span><a href="/changelog/">Changelog</a><a href="/privacy/">Privacy</a></footer>
  </body>
</html>

<style>
  .gallery { max-width: 1600px; margin: auto; }
  .gallery-intro { padding: clamp(3rem, 5vw, 5rem) clamp(24px, 4vw, 70px) 2.5rem; border-bottom: 1px solid var(--sb-rule); }
  .gallery-intro h1, .marked-intro h2 { font: 500 clamp(3.5rem, 6.5vw, 6rem)/1.04 var(--sb-font-heading); letter-spacing: -.04em; margin: 0 0 1.5rem; }
  .gallery-intro p, .marked-intro p { max-width: 65ch; line-height: 1.7; color: var(--sb-ink-soft); font-size: 1.05rem; }
  .gallery-grid { display: grid; grid-template-columns: minmax(180px, .27fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 5rem); padding: 0 clamp(24px, 4vw, 70px); }
  .gallery-examples, .workbook, .page-strip { min-width: 0; max-width: 100%; }
  .gallery-index { position: sticky; top: 1rem; align-self: start; padding-top: 3rem; display: grid; }
  .gallery-index a { display: grid; gap: .2rem; padding: 1rem 0; border-top: 1px solid var(--sb-rule); text-decoration: none; }
  .gallery-index a:hover span { text-decoration: underline; }
  .gallery-index span { font-family: var(--sb-font-heading); font-size: 1.15rem; line-height: 1.3; }
  .gallery-index small { color: var(--sb-ink-soft); line-height: 1.45; }
  .workbook { padding: 5rem 0 7rem; border-bottom: 1px solid var(--sb-rule); scroll-margin-top: 1rem; }
  .workbook:first-child { padding-top: 2.75rem; }
  .workbook-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .workbook-heading h2 { font: 500 clamp(2.4rem, 3.8vw, 3.8rem)/1.1 var(--sb-font-heading); letter-spacing: -.03em; max-width: 20ch; margin: 0 0 1rem; }
  .workbook-heading p, .request-label { font-size: .8rem; color: var(--sb-ink-soft); }
  .request-label { text-transform: uppercase; letter-spacing: .12em; margin-bottom: .5rem; }
  .workbook-tags { margin: 0 0 2.25rem; color: var(--sb-ink-soft); }
  .workbook-tags a { color: var(--sb-ink); font-weight: 600; text-underline-offset: .25em; }
  blockquote { max-width: 29ch; font: 500 clamp(1.5rem, 2.3vw, 2.2rem)/1.3 var(--sb-font-heading); letter-spacing: -.02em; margin: 0 0 1.5rem; }
  .style-reason { max-width: 60ch; color: var(--sb-ink-soft); line-height: 1.65; margin: 0 0 2.5rem; }
  .style-reason strong { color: var(--sb-ink); }
  .page-strip { display: flex; gap: .8rem; overflow-x: auto; padding: 0 0 1rem; margin-bottom: 2.5rem; scrollbar-color: var(--sb-forest) var(--sb-rule); }
  .page-thumb { flex: 0 0 106px; text-decoration: none; font-size: .75rem; color: var(--sb-ink-soft); }
  .page-thumb:hover { color: var(--sb-ink); }
  .thumb-paper { display: block; width: 106px; height: 150px; overflow: hidden; background: white; border: 1px solid var(--sb-rule); margin-bottom: .5rem; }
  /* A page file keeps the renderer's on-screen margin (9mm above and below each sheet), so each frame
     is 18mm taller than the sheet and shifted up 9mm: the sheet itself fills the frame, with no grey
     band above it, its foot strip intact, and no scrollbars. tests/showcase.test.mjs pins the 9mm. */
  .thumb-paper iframe { width: 794px; height: calc(1123px + 18mm); border: 0; pointer-events: none; transform: scale(.133) translateY(-9mm); transform-origin: 0 0; }
  .feature-layout { display: grid; grid-template-columns: minmax(0, 560px) minmax(150px, 1fr); align-items: end; gap: 2rem; }
  .feature-paper { width: 560px; max-width: 100%; aspect-ratio: 210 / 297; overflow: hidden; background: white; box-shadow: 8px 14px 30px rgba(0,0,0,.14); }
  .feature-paper iframe { width: 794px; height: calc(1123px + 18mm); border: 0; transform: scale(.705) translateY(-9mm); transform-origin: 0 0; }
  .thumb-paper.is-landscape { width: 150px; height: 106px; }
  .thumb-paper.is-landscape iframe { width: 1123px; height: calc(794px + 18mm); }
  .feature-paper.is-landscape { aspect-ratio: 297 / 210; }
  .feature-paper.is-landscape iframe { width: 1123px; height: calc(794px + 18mm); transform: scale(.4987) translateY(-9mm); }
  .feature-caption { display: grid; gap: .8rem; align-content: end; padding-bottom: 1rem; }
  .feature-caption p { color: var(--sb-ink-soft); line-height: 1.5; }
  .feature-caption a { color: var(--sb-ink); font-weight: 600; text-underline-offset: .25em; }
  .marked-intro { padding: 6rem clamp(24px, 4vw, 70px) 0; }
  .marked-intro a { color: var(--sb-ink); font-weight: 600; }
  .returned-pair { display: grid; grid-template-columns: minmax(0, 460px) minmax(0, 520px); gap: clamp(2rem, 5vw, 5rem); align-items: center; padding: 3rem clamp(24px, 4vw, 70px) 7rem; }
  .returned-page { margin: 0; transform: rotate(-1.2deg); }
  .returned-page :global(.marked-page) { box-shadow: 10px 18px 32px rgba(20, 40, 34, .18); }
  .returned-page figcaption { margin-top: 1rem; color: var(--sb-ink-soft); font-size: .8rem; line-height: 1.5; }
  @media (max-width: 900px) { .returned-pair { grid-template-columns: minmax(0, 1fr); } .returned-page { width: min(100%, 440px); } .gallery-grid { grid-template-columns: minmax(0, 1fr); } .gallery-index { position: static; display: flex; overflow-x: auto; gap: 1.5rem; padding: 1.5rem 0 0; min-width: 0; max-width: 100%; } .gallery-index a { flex: 0 0 180px; } .workbook { padding-top: 3rem; } }
  @media (max-width: 640px) { .gallery-intro, .marked-intro { padding-inline: 20px; } .gallery-grid { padding-inline: 20px; } .gallery-intro h1, .marked-intro h2 { font-size: 3.4rem; } .feature-layout { display: block; } .feature-paper { width: min(100%, 350px); } .feature-paper iframe { transform: scale(.44) translateY(-9mm); } .feature-paper.is-landscape iframe { transform: scale(.311) translateY(-9mm); } .feature-caption { padding-top: 1rem; } .workbook-heading { display: block; } .workbook-heading h2 { margin-bottom: .2rem; } .workbook-heading p { margin-bottom: 2rem; } }
</style>
