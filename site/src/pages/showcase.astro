---
import "../styles/global.css";
import workbooks from "../generated/showcase.json";
import SiteNav from "../components/SiteNav.astro";
import WorkedExample from "../components/WorkedExample.astro";

const STYLE_INTENT = {
  sitting: "One session to make a first move.",
  series: "Several rounds around one subject.",
  incubation: "Generate, step away, then judge.",
  ritual: "The same short page each time.",
  proof: "A document made ready for margin notes.",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Showcase — Switchback</title>
    <meta name="description" content="Five real Switchback print examples with every page and a PDF for each." />
  </head>
  <body>
    <SiteNav />
    <main class="gallery">
      <header class="gallery-intro">
        <h1>Pages to work on.</h1>
        <p>Five examples printed by the current Switchback renderer. Each page below is the renderer's own output, shown at A4 proportions. Open a page at full size to inspect the print.</p>
      </header>
      <div class="gallery-grid">
        <nav class="gallery-index" aria-label="Showcase examples">
          {workbooks.map((workbook) => <a href={`#${workbook.style}`}><span>{workbook.label}</span><small>{STYLE_INTENT[workbook.style]}</small></a>)}
        </nav>
        <div class="gallery-examples">
          {workbooks.map((workbook) => {
            const feature = workbook.pagePreviews[Math.min(1, workbook.pagePreviews.length - 1)];
            return <section class="workbook" id={workbook.style} aria-labelledby={`${workbook.style}-title`}>
              <div class="workbook-heading"><h2 id={`${workbook.style}-title`}>{workbook.label}</h2><p>{workbook.pageCount} {workbook.pageCount === 1 ? "page" : "pages"} · {workbook.timebox}</p></div>
              <p class="request-label">Request</p>
              <blockquote>“{workbook.request}”</blockquote>
              <p class="style-reason"><strong>Why {workbook.label}</strong> {workbook.why}</p>
              <div class="page-strip" aria-label={`All ${workbook.pageCount} ${workbook.label} pages`}>
                {workbook.pagePreviews.map((page, index) => <a class="page-thumb" href={page.html} aria-label={`Open ${workbook.label} page ${index + 1} at full size`}>
                  <span class="thumb-paper"><iframe src={page.html} title={`${workbook.label} ${page.id} thumbnail`} loading="lazy" tabindex="-1"></iframe></span>
                  <span>{page.id}</span>
                </a>)}
              </div>
              <div class="feature-layout">
                <div class="feature-paper"><iframe src={feature.html} title={`${workbook.label} ${feature.id} printed page`} loading="lazy"></iframe></div>
                <div class="feature-caption"><p>One page from the {workbook.label.toLowerCase()} example, shown as printed.</p><a href={feature.html}>Open this page full size</a><a href={workbook.pdf} download>Download the PDF</a></div>
              </div>
            </section>;
          })}
        </div>
      </div>
      <div class="marked-intro"><h2>When the page returns.</h2><p>This illustrative marked sheet and its readback are one matched example. The marks are authored; the unmarked sheet is renderer output.</p></div>
      <WorkedExample />
    </main>
    <footer class="site-footer"><span>Switchback · paper back to the agent</span><a href="/changelog/">Changelog</a><a href="/privacy/">Privacy</a></footer>
  </body>
</html>

<style>
  .gallery { max-width: 1600px; margin: auto; }
  .gallery-intro { padding: clamp(4rem, 7vw, 7rem) clamp(24px, 4vw, 70px) 4rem; border-bottom: 1px solid var(--sb-rule); }
  .gallery-intro h1, .marked-intro h2 { font: 500 clamp(3.5rem, 7vw, 7rem)/1.04 var(--sb-font-heading); letter-spacing: -.035em; margin: 0 0 1.5rem; }
  .gallery-intro p, .marked-intro p { max-width: 65ch; line-height: 1.7; color: var(--sb-ink-soft); font-size: 1.05rem; }
  .gallery-grid { display: grid; grid-template-columns: minmax(180px, .27fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 5rem); padding: 0 clamp(24px, 4vw, 70px); }
  .gallery-index { position: sticky; top: 1rem; align-self: start; padding-top: 3rem; display: grid; }
  .gallery-index a { display: grid; gap: .2rem; padding: 1rem 0; border-top: 1px solid var(--sb-rule); text-decoration: none; }
  .gallery-index a:hover span { text-decoration: underline; }
  .gallery-index span { font-family: var(--sb-font-heading); font-size: 1.3rem; }
  .gallery-index small { color: var(--sb-ink-soft); line-height: 1.45; }
  .workbook { padding: 5rem 0 7rem; border-bottom: 1px solid var(--sb-rule); scroll-margin-top: 1rem; }
  .workbook-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .workbook-heading h2 { font: 500 clamp(3rem, 5vw, 5rem)/1.1 var(--sb-font-heading); letter-spacing: -.03em; margin: 0 0 2rem; }
  .workbook-heading p, .request-label { font-size: .8rem; color: var(--sb-ink-soft); }
  .request-label { text-transform: uppercase; letter-spacing: .12em; margin-bottom: .5rem; }
  blockquote { max-width: 29ch; font: 500 clamp(1.5rem, 2.6vw, 2.5rem)/1.3 var(--sb-font-heading); margin: 0 0 1.5rem; }
  .style-reason { max-width: 60ch; color: var(--sb-ink-soft); line-height: 1.65; margin: 0 0 2.5rem; }
  .style-reason strong { color: var(--sb-ink); }
  .page-strip { display: flex; gap: .8rem; overflow-x: auto; padding: 0 0 1rem; margin-bottom: 2.5rem; scrollbar-color: var(--sb-forest) var(--sb-rule); }
  .page-thumb { flex: 0 0 106px; text-decoration: none; font-size: .75rem; color: var(--sb-ink-soft); }
  .page-thumb:hover { color: var(--sb-ink); }
  .thumb-paper { display: block; width: 106px; height: 150px; overflow: hidden; background: white; border: 1px solid var(--sb-rule); margin-bottom: .5rem; }
  .thumb-paper iframe { width: 794px; height: 1123px; border: 0; pointer-events: none; transform: scale(.133); transform-origin: 0 0; }
  .feature-layout { display: grid; grid-template-columns: minmax(0, 560px) minmax(150px, 1fr); align-items: end; gap: 2rem; }
  .feature-paper { width: 560px; max-width: 100%; aspect-ratio: 210 / 297; overflow: hidden; background: white; box-shadow: 8px 14px 30px rgba(0,0,0,.14); }
  .feature-paper iframe { width: 794px; height: 1123px; border: 0; transform: scale(.705); transform-origin: 0 0; }
  .feature-caption { display: grid; gap: .8rem; align-content: end; padding-bottom: 1rem; }
  .feature-caption p { color: var(--sb-ink-soft); line-height: 1.5; }
  .feature-caption a { color: var(--sb-ink); font-weight: 600; text-underline-offset: .25em; }
  .marked-intro { padding: 6rem clamp(24px, 4vw, 70px) 0; }
  .gallery :global(.worked-example) { padding-top: 2rem; }
  @media (max-width: 900px) { .gallery-grid { grid-template-columns: 1fr; } .gallery-index { position: static; display: flex; overflow-x: auto; gap: 1.5rem; padding: 1.5rem 0 0; } .gallery-index a { flex: 0 0 140px; } .workbook { padding-top: 3rem; } }
  @media (max-width: 640px) { .gallery-intro, .marked-intro { padding-inline: 20px; } .gallery-grid { padding-inline: 20px; } .gallery-intro h1, .marked-intro h2 { font-size: 3.4rem; } .feature-layout { display: block; } .feature-paper { width: 100%; } .feature-paper iframe { transform: scale(.44); } .feature-caption { padding-top: 1rem; } .workbook-heading { display: block; } .workbook-heading h2 { margin-bottom: .2rem; } .workbook-heading p { margin-bottom: 2rem; } }
</style>
