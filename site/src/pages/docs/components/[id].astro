---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import PagePreview from "../../../components/PagePreview.astro";
import catalogue from "../../../generated/catalogue.json";
import collections from "../../../generated/collections.json";

export function getStaticPaths() {
  return catalogue.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;

function sourceHref(source) {
  if (source.url) return source.url;
  if (source.doi) return `https://doi.org/${source.doi}`;
  if (source.isbn) return `https://isbnsearch.org/isbn/${source.isbn.replace(/[^0-9Xx]/g, "")}`;
  return null;
}

const claims = item.grounding?.claims ?? [];
const shelfName = new Map(collections.map((c) => [c.id, c.name]));

// A practical template's origin reads as a sentence, whatever case or stop it was written with.
function sentence(text) {
  const s = (text ?? "").trim();
  if (!s) return "";
  const capped = s[0].toUpperCase() + s.slice(1);
  return /[.!?]$/.test(capped) ? capped : `${capped}.`;
}
---

<StarlightPage
  frontmatter={{
    title: item.title,
    description: item.intent,
  }}
>
  <p class="component-meta">
    <span class="component-kind">{item.kind}</span>
    {item.tags.map((tag) => <span class="component-tag">{tag}</span>)}
    {item.phase && <span class="component-phase">{item.phase}</span>}
  </p>

  {
    item.collections.length > 0 && (
      <p class="in-collections">
        In collections:{" "}
        {item.collections.map((id, i) => (
          <>
            {i > 0 && ", "}
            <a href={`/docs/collections/${id}/`}>{shelfName.get(id) ?? id}</a>
          </>
        ))}
      </p>
    )
  }

  <p>{item.intent}</p>

  {
    item.extends && (
      <p>
        A preset of <a href={`/docs/components/${item.extends}/`}>{item.extends}</a>.
        {item.attribution && item.basis !== "practice" && ` Attribution: ${item.attribution}.`}
        {item.licence && ` Licence: ${item.licence}.`}
      </p>
    )
  }

  <PagePreview id={item.id} title={item.title} orientation={item.orientation} />

  {
    item.variants.length > 0 && (
      <>
        <h2>Variants</h2>
        <ul>
          {item.variants.map((variant) => (
            <li>
              <strong>{variant.label ?? variant.id}</strong>
              {variant.requires.length > 0 && ` — needs ${variant.requires.join(", ")}`}
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    item.dataFields.length > 0 && (
      <>
        <h2>Data fields</h2>
        <p>The fields a spec's page can set for this component (see <code>switchback show {item.id} --json</code>):</p>
        <ul>
          {item.dataFields.map((field) => (
            <li>
              <code>{field}</code>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    item.basis === "research" ? (
      <p class="basis basis-research">Research-backed</p>
    ) : (
      <p class="basis basis-practice">
        <strong>Practical template.</strong> {sentence(item.origin)} It makes no research claim.
      </p>
    )
  }

  {
    claims.length > 0 && (
      <>
        <h2>Grounding</h2>
        {item.grounding.helps && (
          <p>
            <strong>Helps:</strong> {item.grounding.helps}
          </p>
        )}
        {item.grounding.backfires && (
          <p>
            <strong>Backfires:</strong> {item.grounding.backfires}
          </p>
        )}
        <ul class="claims">
          {claims.map((claim) => (
            <li>
              <span class={`grade grade-${claim.grade}`}>{claim.grade}</span>
              {claim.claim}
              <span class="sources">
                {claim.sources.map((source, i) => {
                  const href = sourceHref(source);
                  return (
                    <>
                      {i > 0 && ", "}
                      {href ? <a href={href}>{source.cite}</a> : source.cite}
                    </>
                  );
                })}
              </span>
            </li>
          ))}
        </ul>
        <p>
          <a href="/docs/evidence/">What the grades mean</a>
        </p>
      </>
    )
  }
</StarlightPage>

<style>
  .component-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .component-kind,
  .component-tag,
  .component-phase {
    font-size: var(--sl-text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-text-accent);
  }
  .in-collections {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .basis {
    margin-top: 2rem;
  }
  .basis-research {
    font-size: var(--sl-text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sl-color-text-accent);
  }
  .basis-practice {
    color: var(--sl-color-gray-2);
  }
  .claims {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .grade {
    display: inline-block;
    width: 1.5em;
    text-align: center;
    font-weight: 700;
    border-radius: 0.25em;
    margin-inline-end: 0.5em;
    border: 1px solid var(--sl-color-hairline);
  }
  .sources {
    display: block;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text-accent);
  }
</style>
