---
const groups = [
  {
    title: "Claude Code: run both, in order",
    commands: ["/plugin marketplace add vandermerwed/switchback", "/plugin install switchback@switchback"],
  },
  {
    title: "Codex, opencode, Cursor and other agents",
    commands: ["npx skills add vandermerwed/switchback"],
  },
  {
    title: "Optional: install the CLI once, instead of fetching it with npx each time",
    commands: ["npm install -g @vandermerwed/switchback"],
  },
];
---

<section class="install-section" id="install" aria-labelledby="install-title">
  <div class="install-heading">
    <h2 id="install-title">Begin with a page.</h2>
    <p>Install Switchback through whichever group matches your setup, then ask for a focused paper session on the decision in front of you.</p>
    <p class="requirements">Requirements: Node.js 20.12 or later, a printer, a pen, a phone camera.</p>
  </div>
  <div class="install-groups">
    {groups.map((group) => (
      <div class="install-group">
        <h3>{group.title}</h3>
        {group.commands.map((command) => (
          <div class="install-command">
            <pre tabindex="0"><code>{command}</code></pre>
            <button type="button" class="copy-button" data-copy={command} aria-label={`Copy: ${command}`}>Copy</button>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>
<footer class="site-footer">
  <span>Switchback · paper back to the agent</span>
  <a href="/docs/">Read the docs</a>
  <a href="/privacy/">Privacy</a>
</footer>

<script>
  function setUpCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>(".copy-button").forEach((button) => {
      const text = button.dataset.copy ?? "";
      const defaultLabel = button.textContent ?? "Copy";
      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(text);
          button.textContent = "Copied";
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            button.textContent = defaultLabel;
          }, 2000);
        } catch {
          // The clipboard can refuse (permissions, an insecure context, an older browser); the
          // command is already selectable text in the <pre>, so there is nothing else to do here.
        }
      });
    });
  }
  setUpCopyButtons();
</script>
