---
import Search from "@astrojs/starlight/components/Search.astro";
import SiteNav from "./SiteNav.astro";
---
<div class="docs-header">
  <SiteNav />
  <div class="docs-search"><Search /></div>
</div>
<style>
  .docs-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; width: 100%; }
  .docs-header :global(.site-nav) { flex: 1; max-width: none; padding-block: .75rem; }
  .docs-search { padding-right: 1rem; }
  @media (max-width: 800px) { .docs-header { display: block; } .docs-search { display: none; } }
</style>
