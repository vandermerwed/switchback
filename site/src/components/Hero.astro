---
import readback from "../../example/readback.json";
import SiteNav from "./SiteNav.astro";

const ask = readback.marks.find((mark) => mark.role === "ask");
const stop = readback.marks.find((mark) => mark.role === "stop");
const crux = readback.marks.find((mark) => mark.role === "crux");
---

<section class="hero" aria-labelledby="home-title">
  <div class="hero-glow" aria-hidden="true"></div>
  <SiteNav />
  <svg class="return-route" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="route route-out" d="M43.5 21 C47 24.5 47.2 28.5 44 31.5 C41.8 33.7 43 38 46.3 40.5 C48.6 42.3 47.6 46.5 44.8 49 C43 50.6 44 55.5 49.5 58" />
    <path class="route" d="M72 31 C76 30.5 79 30 80.5 29.5 C83 27 85.5 21 88.5 22.5 C91.5 24 90 30 92.5 33 C94.5 35.5 95.5 39 95 43.2" />
    <path class="route-ring route-out" d="M43.5 21 h0" />
    <path class="route-dot route-out" d="M43.5 21 h0" />
    <path class="route-ring" d="M95 43.2 h0" />
    <path class="route-dot" d="M95 43.2 h0" />
  </svg>

  <div class="hero-copy">
    <h1 id="home-title"><span>Step away from the agents.</span><span>Come back with a clearer thought.</span></h1>
    <p>Your agent prints a page for the problem you are stuck on. You work it in ink away from the screen, photograph it, and the agent picks up from what you wrote.</p>
    <div class="hero-actions">
      <a class="primary-action" href="#install">Install Switchback <span aria-hidden="true">→</span></a>
      <a class="secondary-action" href="#how-it-works">See a round trip ↓</a>
    </div>
  </div>

  <div class="hero-scene" aria-label="Illustrative example of a Switchback round trip">
    <svg class="mobile-route" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M16 7 C7 21 20 27 48 33 C85 42 89 55 52 64 C22 72 35 83 78 91" /></svg>
    <div class="agent-prompt">
      <span class="scene-label">You ask</span>
      <p>“Help me decide what goes in v1. Let's do it on paper.”</p>
    </div>
    <figure class="hero-paper">
      <div class="marked-paper">
        <img src="/example/generated-page.png" width="1588" height="2246" alt="Unmarked Switchback page W1-P2, Before the next handoff, printed with the prompt What is the decision we are avoiding?" />
        <div class="paper-mark paper-ask"><b>{ask?.mark}</b><span>{ask?.text}</span><small>{ask?.label}</small></div>
        <div class="paper-mark paper-stop"><span>{stop?.text}</span><small>{stop?.label}</small></div>
        <div class="paper-mark paper-crux"><span>{crux?.text}</span><small>{crux?.label}</small></div>
      </div>
      <figcaption>Illustrative example · W1-P2 · marks authored for this demonstration</figcaption>
    </figure>
    <div class="agent-readback">
      <span class="scene-label">Agent reads it back</span>
      <p><strong>Ask Q1:</strong> {readback.heroAnswer}</p>
      <p><strong>Stop:</strong> {readback.heroUnresolved}</p>
    </div>
    <span class="photo-label">Photo</span>
  </div>
</section>
