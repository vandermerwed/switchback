---
import markUrl from "../assets/switchback-mark.svg?url";

const path = Astro.url.pathname;
const active = path.startsWith("/docs/")
  ? "docs"
  : path.startsWith("/showcase/")
    ? "showcase"
    : path === "/"
      ? "home"
      : "other";
---

<nav class:list={["site-nav", { "on-forest": active === "home" }]} aria-label="Main navigation">
  <a class="brand" href="/" aria-label="Switchback home" aria-current={active === "home" ? "page" : undefined}>
    <img src={markUrl} width="32" height="32" alt="" />
    <span>Switchback</span>
  </a>
  <div class="nav-links">
    <a href={active === "home" ? "#install" : "/#install"}>Install</a>
    <a href="/docs/" aria-current={active === "docs" ? "page" : undefined}>Docs</a>
    <a href="/showcase/" aria-current={active === "showcase" ? "page" : undefined}>Showcase</a>
    <a href="https://github.com/vandermerwed/switchback">GitHub</a>
    <button class="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false" title="Switch colour theme">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.25" /><path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" /></svg>
    </button>
  </div>
</nav>
<script>
  const key = "starlight-theme";
  const stored = localStorage.getItem(key);
  const preferred = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  document.documentElement.dataset.theme = stored === "dark" || stored === "light" ? stored : preferred;
  const toggles = document.querySelectorAll<HTMLButtonElement>(".theme-toggle");
  const showState = () =>
    toggles.forEach((button) => button.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "dark")));
  showState();
  toggles.forEach((button) => {
    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      localStorage.setItem(key, next);
      showState();
    });
  });
</script>
<style>
  .site-nav { position: relative; z-index: 6; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; width: 100%; max-width: 1600px; margin: auto; padding: 24px clamp(24px, 3.5vw, 58px); color: var(--sb-ink); background: var(--sb-paper); }
  .site-nav.on-forest { color: #f7f9f6; background: transparent; }
  .brand { display: inline-flex; align-items: center; gap: .8rem; text-decoration: none; text-transform: uppercase; letter-spacing: .27em; font-size: .87rem; font-weight: 600; white-space: nowrap; color: inherit; }
  .brand img { flex: none; width: 29px; height: 29px; }
  .brand img { filter: none; }
  .on-forest .brand img { filter: invert(1); }
  :global(:root[data-theme="dark"]) .brand img { filter: invert(1); }
  .nav-links { display: flex; gap: clamp(1.2rem, 3vw, 3rem); align-items: center; }
  .nav-links a { color: inherit; text-decoration: none; font-size: .9rem; }
  .nav-links a:hover { text-decoration: underline; }
  .site-nav a:focus-visible { outline: 3px solid var(--sb-trail); outline-offset: 4px; }
  .nav-links a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--sb-trail); text-decoration-thickness: 2px; text-underline-offset: .55em; }
  .theme-toggle { display: inline-grid; place-items: center; border: 0; border-radius: 50%; width: 2.5rem; height: 2.5rem; color: inherit; opacity: .72; background: transparent; cursor: pointer; }
  .theme-toggle svg { width: 1.2rem; height: 1.2rem; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .theme-toggle path { fill: currentColor; stroke: none; }
  .theme-toggle:hover { opacity: 1; }
  .theme-toggle:focus-visible { outline: 3px solid var(--sb-trail); outline-offset: 3px; }
  @media (max-width: 640px) {
    .site-nav { flex-wrap: wrap; gap: 1rem; padding: 19px 20px; }
    .brand { font-size: .76rem; letter-spacing: .2em; }
    .brand img { width: 24px; height: 24px; }
    .nav-links { width: 100%; justify-content: space-between; gap: .55rem; }
    .nav-links a { font-size: .8rem; }
  }
</style>
