    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.4",
    "@vandermerwed/switchback": "workspace:*",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/react": "^7.0.0",
    "agentation": "^3.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
