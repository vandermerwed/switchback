{
  "name": "@switchback/site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "pnpm --filter @vandermerwed/switchback build && node scripts/generate.mjs",
