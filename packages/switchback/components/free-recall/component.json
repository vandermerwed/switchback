                "type": "experiment"
              }
            ],
            "rationale": "research/memory-retrieval.md#pretesting"
          }
        ],
        "helps": "when used before first studying a text: attempting the prompts first, even with wrong answers, improves later memory for the prompted material, provided the answers are then studied",
        "backfires": "when the answers are never studied afterwards, or when the prompts narrow reading to the prompted parts, which studies of reading (though not of video) have reported"
      }
