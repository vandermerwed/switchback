<section class="sb-page sb-landscape" id="W1-P1" data-component="zones"><i class="sb-reg sb-tl"></i><i class="sb-reg sb-tr"></i><i class="sb-reg sb-bl"></i><i class="sb-reg sb-br"></i><header class="sb-ph"><span class="sb-pid">W1-P1</span><span class="sb-ptitle">Zones</span><span class="sb-ptag">zones</span></header><p class="sb-prompt">Place or write into the zones as the session moves; update them when something changes.</p><div class="sb-pbody"><div class="sb-c-zones-grid sb-fill" style="grid-template-columns:repeat(3,1fr)"><div class="sb-box"><span class="sb-label">Alpha</span></div><div class="sb-box"><span class="sb-label">Beta</span></div><div class="sb-box"><span class="sb-label">Gamma</span></div><div class="sb-box"><span class="sb-label">Delta</span></div><div class="sb-box"><span class="sb-label">Epsilon</span></div><div class="sb-box"><span class="sb-label">Zeta</span></div><div class="sb-box"><span class="sb-label">Eta</span></div><div class="sb-box"><span class="sb-label">Theta</span></div><div class="sb-box"><span class="sb-label">Iota</span></div></div></div><footer class="sb-pfoot"><div class="sb-legend"><span><span class="sb-letter">Q</span> ask</span><span><span class="sb-letter">R</span> stop</span><span><span class="sb-letter">G</span> keep</span><span>X crux = highlighter</span><span><span class="sb-letter">O</span> maybe</span><span><span class="sb-letter">P</span> sense</span><span><span class="sb-letter">D</span> draft</span><span>B reason = black</span><span class="sb-legend-id">W1-P1</span></div></footer></section>
</body>
</html>
"
`;
