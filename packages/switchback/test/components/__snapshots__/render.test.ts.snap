.sb-lines .sb-rule { height: var(--sb-pitch); flex: 0 0 auto; border-bottom: 0.4pt solid var(--sb-rule); }
.sb-lines.sb-fill .sb-rule { flex: 1 1 0; height: auto; min-height: var(--sb-pitch); }
