.sb-legend-table td { padding: 1.6mm 2mm; vertical-align: middle; border-bottom: 0.4pt solid #e2e2e2; }
.sb-swatch span { display: block; width: 8mm; height: 6mm; border: 0.7pt solid var(--sb-line); border-radius: 1mm; }
