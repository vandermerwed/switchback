.sb-pfoot { position: absolute; left: 15mm; right: 15mm; bottom: 6mm; padding-top: 1.5mm; border-top: 0.4pt solid #cccccc; }
.sb-attrib { margin: 0 0 1mm; font: 400 6.5pt var(--sb-mono); color: var(--sb-faint); }
