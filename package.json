{
  "name": "switchback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && node --test scripts/check-skills.test.mjs",
    "lint": "biome check . && node scripts/check-skills.mjs",
    "format": "biome format --write .",
    "validate": "pnpm --filter @vandermerwed/switchback run validate:strict",
    "apply-grounding": "pnpm --filter @vandermerwed/switchback run apply-grounding",
    "contact-sheet": "pnpm --filter @vandermerwed/switchback run contact-sheet",
    "check-skills": "node scripts/check-skills.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
